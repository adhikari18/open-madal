{
  "name": "open-madal",
  "version": "0.1.0",
  "private": true,
  "description": "Digital preservation, declarative MadalCode notation compiler, and interactive web sequencer for the traditional Nepali Madal hand drum.",
  "license": "MIT",
  "author": "Ashok Adhikari",
  "repository": {
    "type": "git",
    "url": "https://github.com/adhikari18/open-madal.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace=@open-madal/web",
    "cli": "node packages/cli/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

